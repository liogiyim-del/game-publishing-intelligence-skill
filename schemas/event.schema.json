      }
    },
    "behavioral_mechanism_hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "behavior_evidence_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "regional_difference": {
      "type": [
        "array",
        "object",
        "null"
      ]
    },
    "crisis_response_assessment": {
      "type": [
        "object",
        "null"
      ]
    },
    "case_specific_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transferable_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_transferable_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "targeted_research_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "field_status": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "confirmed",
          "partially_confirmed",
          "inferred",
          "unknown",
          "not_applicable"
        ]
      }
    }
  },
  "additionalProperties": true
}